# Copy to .env (or export these) before running docker compose.

# REQUIRED in production: a long random string.
#   generate with: openssl rand -hex 32
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to "true" only for local debugging.
DJANGO_DEBUG=false

# Comma-separated hostnames allowed to serve the app ("*" allows all).
DJANGO_ALLOWED_HOSTS=*

# Where the SQLite DB + uploaded media are stored (mounted as a volume).
DATA_DIR=/data

# --- Optional: use Postgres instead of SQLite ---
# DATABASE_URL=postgres://slack:slack@postgres:5432/slack

# --- Optional: use Redis for the Channels layer (multi-process / scaling) ---
# REDIS_URL=redis://redis:6379/0

# Max attachment upload size in bytes (default 25MB).
# MAX_UPLOAD_BYTES=26214400
