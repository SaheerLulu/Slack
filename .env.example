# Copy to .env (or export these) before running docker compose.

# REQUIRED in production: a long random string.
#   generate with: openssl rand -hex 32
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to "true" only for local debugging.
DJANGO_DEBUG=false

# Comma-separated hostnames allowed to serve the app ("*" allows all).
DJANGO_ALLOWED_HOSTS=*
# When behind the Caddy TLS proxy, list your https origins so POSTs pass CSRF:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://chat.example.com

# --- TLS / HTTPS via the Caddy reverse proxy (docker compose --profile tls) ---
# Public hostnames with DNS A/AAAA records pointing at this host.
# APP_DOMAIN=chat.example.com
# LIVEKIT_DOMAIN=livekit.example.com
# ACME_EMAIL=you@example.com
# With TLS enabled, also set (so the browser uses secure WebSockets):
#   LIVEKIT_WS_URL=wss://livekit.example.com
#   DJANGO_ALLOWED_HOSTS=chat.example.com
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://chat.example.com

# Where the SQLite DB + uploaded media are stored (mounted as a volume).
DATA_DIR=/data

# --- Optional: use Postgres instead of SQLite ---
# DATABASE_URL=postgres://slack:slack@postgres:5432/slack

# --- Optional: use Redis for the Channels layer (multi-process / scaling) ---
# REDIS_URL=redis://redis:6379/0

# Max attachment upload size in bytes (default 25MB).
# MAX_UPLOAD_BYTES=26214400

# --- Calls (LiveKit SFU for group video + screen share) ---
# URL the BROWSER connects to. Local default works out of the box; for a
# remote/public deployment set this to your reachable address (use wss:// when
# the app is served over HTTPS), e.g. wss://livekit.example.com
LIVEKIT_WS_URL=ws://localhost:7880
# Must match the keys in infra/livekit.yaml. CHANGE in production.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-at-least-32-bytes-long
# Set to false to hide/disable the call buttons entirely.
CALLS_ENABLED=true
# Advertise extra ICE/TURN servers to clients (JSON). Use with --profile turn:
# EXTRA_ICE_SERVERS=[{"urls":"turn:localhost:3478","username":"slack","credential":"slackturnpassword"}]
